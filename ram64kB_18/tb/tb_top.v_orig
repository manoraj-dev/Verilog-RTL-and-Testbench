`timescale 1ns/1ns

`include "../src/dut.v"

module tb_top;

localparam ADDRWIDTH=16;
localparam DATAWIDTH=8;
localparam DEPTH=50;

reg clk;
reg wr_en, rd_en;
reg [ADDRWIDTH-1:0]  wr_addr;
reg [ADDRWIDTH-1:0]  rd_addr;
reg  [DATAWIDTH-1:0] data_in;
wire [DATAWIDTH-1:0] data_out;

RAM_64KB #(ADDRWIDTH, DATAWIDTH, DEPTH) dut(
	.clk(clk),
	.wr_en(wr_en),
	.rd_en(rd_en),
	.wr_addr(wr_addr),
	.rd_addr(rd_addr),
	.data_in(data_in),
	.data_out(data_out)
);

initial begin
    clk    =0;
	 wr_en  =0;
	 rd_en  =0;
	 wr_addr=0;
	 rd_addr=0;
end

always #5 clk = ~clk;

initial begin
	write_mem_nbytes(50);
	//read_mem_nbytes(50);
end

always begin
   @(posedge clk);
   $monitor("$TIME=%0t | WR_EN=%b | RD_EN=%b | WR_ADDR=%b | RD_ADDR=%b | DATA_IN=%b | DATA_OUT=%0d", $time, wr_en, rd_en, wr_addr, rd_addr, data_in, data_out);
end

initial begin
	$dumpfile("waveform.vcd");
	$dumpvars("0, tb_top");
end


task write_mem_nbytes(integer bytes=16);
begin
//repeat(bytes) begin end
	@(posedge clk);
	begin
		wr_en =1;
		for (integer i=0; i<bytes;i=i++)
			begin
      	wr_addr=i;
      	data_in=$random;
		end
	end
	wr_en =0;
	$display("Written bytes number of data into the RAM locations...");
end
endtask

task read_mem_nbytes(integer bytes=16);
begin
//repeat(bytes) begin end
	@(posedge clk);
	begin
		rd_en =1;
		for (integer i=0; i<bytes;i=i++)
		begin
      	rd_addr=i;
		end
	end
	rd_en =0;
	$display("Read bytes number of data from the RAM locations...");
end
endtask

initial begin
	#60;
	$finish;
end

endmodule
